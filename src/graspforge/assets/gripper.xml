<?xml version="1.0"?>
<mujoco model="parallel_gripper">
  <!-- Implicit damping and an elliptic cone support stable force control. -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast" cone="elliptic" impratio="10.0"/>
  <visual>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="4096"/>
  </visual>
  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.20 0.25 0.30" rgb2="0.15 0.20 0.25"/>
    <material name="floor" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <material name="table" rgba="0.55 0.42 0.30 1"/>
    <material name="cube" rgba="0.85 0.30 0.25 1"/>
    <material name="gripper" rgba="0.60 0.60 0.65 1"/>
    <material name="pad" rgba="0.15 0.15 0.15 1"/>
  </asset>
  <default>
    <!-- Visual geometry is non-colliding; pad geometry remains collision-active. -->
    <default class="visual">
      <geom type="box" contype="0" conaffinity="0" group="2" material="gripper"/>
    </default>
    <default class="finger">
      <joint type="slide" range="0.0 0.05" damping="2.0" armature="0.01"/>
      <default class="pad">
        <geom type="box" size="0.01 0.025 0.025" mass="0.02" material="pad"/>
      </default>
      <default class="tip">
        <site type="box" size="0.012 0.027 0.027" rgba="0.75 0 0 0.5"/>
      </default>
    </default>
  </default>
  <worldbody>
    <light name="key" pos="0 -0.6 1.6" dir="0 0.35 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="1 1 0.05" material="floor"/>
    <geom name="table" type="box" size="0.3 0.3 0.2" pos="0.0 0.0 0.2" material="table"/>
    <camera name="front" pos="0 -0.6 0.6" xyaxes="1 0 0  0 0.15 0.6"/>
    <camera name="overview" pos="0 -0.7 0.6" xyaxes="1 0 0  0 0 1"/>
    <!-- The manipulated object uses a seven-value free-joint configuration. -->
    <body name="cube" pos="0.0 0.0 0.45">
      <joint type="free" name="cube_free"/>
      <geom name="cube_geom" type="box" size="0.05 0.05 0.05" mass="0.2" friction="0.8 0.02 0.001" condim="3" priority="1" material="cube"/>
      <site name="cube_center" type="sphere" size="0.005"/>
    </body>
    <!-- Mirrored slide axes make positive control close both fingers. -->
    <body name="carriage" pos="0 0 0.56">
      <joint name="lift" type="slide" axis="0 0 1" range="-0.05 0.25" damping="1" armature="0.01"/>
      <geom name="carriage_geom" class="visual" size="0.12 0.03 0.015" mass="0.5"/>
      <body name="left_finger" pos="-0.08 0 -0.11">
        <joint name="left_slide" axis="1 0 0" class="finger"/>
        <geom name="left_link" class="visual" pos="0 0 0.06" size="0.008 0.01 0.035" mass="0.03"/>
        <geom name="left_pad" class="pad"/>
        <site name="left_tip" class="tip"/>
      </body>
      <body name="right_finger" pos="0.08 0 -0.11">
        <joint name="right_slide" axis="-1 0 0" class="finger"/>
        <geom name="right_link" class="visual" pos="0 0 0.06" size="0.008 0.01 0.035" mass="0.03"/>
        <geom name="right_pad" class="pad"/>
        <site name="right_tip" class="tip"/>
      </body>
    </body>
  </worldbody>
  <contact>
    <!-- Finger self-contact is irrelevant to the grasp task and excluded explicitly. -->
    <exclude body1="left_finger" body2="right_finger"/>
  </contact>
  <actuator>
    <motor name="lift_motor" joint="lift" gear="1.0" ctrlrange="-30 30"/>
    <motor name="left_motor" joint="left_slide" gear="1.0" ctrlrange="-15 15"/>
    <motor name="right_motor" joint="right_slide" gear="1.0" ctrlrange="-15 15"/>
  </actuator>
  <sensor>
    <!-- Volumetric fingertip sites aggregate normal force from enclosed contacts. -->
    <touch name="left_touch" site="left_tip"/>
    <touch name="right_touch" site="right_tip"/>
  </sensor>
  <keyframe>
    <!-- Every episode resets to this deterministic configuration. -->
    <key name="home" qpos="0 0 0.45  1 0 0 0  0  0 0"/>
  </keyframe>
</mujoco>
